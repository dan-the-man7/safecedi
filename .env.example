# SafeCedi configuration template.
#
# Copy this file to .env and fill in real values:
#     cp .env.example .env
#
# .env is git-ignored. Never commit it, never paste its contents into a
# chat, issue or pull request. If a secret leaks, rotate it immediately.

# --- Application ---------------------------------------------------------
# "local" on your laptop, "production" on the live host.
APP_ENV=local
# true shows error detail on screen. MUST be false in production.
APP_DEBUG=true
# Public base URL, no trailing slash.
APP_URL=http://localhost:8000
# Redirect http:// to https:// (set true on the live host once SSL works).
FORCE_HTTPS=false

# --- Database (MySQL / MariaDB) ------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=safecedi
DB_USER=safecedi
DB_PASS=change-me

# --- Sessions -------------------------------------------------------------
# Log a user out after this many minutes of inactivity.
SESSION_IDLE_MINUTES=30

# --- Google Safe Browsing (Lookup API v4) --------------------------------
# Create in Google Cloud Console -> APIs & Services -> Credentials.
# Restrict the key to the Safe Browsing API. See docs/deploy-guide.md.
SAFE_BROWSING_API_KEY=

# --- Operations ------------------------------------------------------------
# Long random string that unlocks /healthcheck.php?token=...
# Leave EMPTY to disable the web health check entirely.
# Generate one with:  php -r 'echo bin2hex(random_bytes(24)), PHP_EOL;'
HEALTHCHECK_TOKEN=
